for i, tabName in ipairs(Tabs) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = i == 1 and Color3.fromRGB(40, 45, 65) or Color3.fromRGB(26, 28, 40)
