local function createRow(labelText, defaultVal, isToggleOnly, onToggle)
	local rowFrame = Instance.new("Frame")
	rowFrame.Size = UDim2.new(1, -6, 0, 36)
	rowFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	rowFrame.BackgroundTransparency = 0.3
	rowFrame.BorderSizePixel = 0
	rowFrame.Parent = ScrollingFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = rowFrame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 170, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(220, 220, 220)
	label.TextSize = 13
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = rowFrame

	local box
	if not isToggleOnly then
		box = Instance.new("TextBox")
		box.Size = UDim2.new(0, 60, 0, 26)
		box.Position = UDim2.new(1, -160, 0.5, -13)
		box.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
		box.TextColor3 = Color3.fromRGB(255, 255, 255)
		box.Text = tostring(defaultVal)
		box.TextSize = 12
		box.Font = Enum.Font.GothamMedium
		box.ClearTextOnFocus = false
		local tCorner = Instance.new("UICorner")
		tCorner.CornerRadius = UDim.new(0, 4)
		tCorner.Parent = box
		box.Parent = rowFrame
	end

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 80, 0, 26)
	btn.Position = UDim2.new(1, -90, 0.5, -13)
	btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Text = "OFF"
	btn.TextSize = 12
	btn.Font = Enum.Font.GothamBold
	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 4)
	bCorner.Parent = btn
	btn.Parent = rowFrame

	local state = false
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = state and "ON" or "OFF"
		btn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(60, 60, 80)
		if onToggle then onToggle(state, box) end
	end)

	return box
end

speedBox = createRow("WalkSpeed", "16", false, function(state) speedEnabled = state end)
jumpBox = createRow("Jump Power (1-50)", "50", false, function(state)
	jumpEnabled = state
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.UseJumpPower = true
		char.Humanoid.JumpPower = jumpEnabled and (tonumber(jumpBox.Text) or 50) or 50
	end
end)
flySpeedBox = createRow("Fly Speed (1-300)", "50", false, function(state) flyEnabled = state end)
vehicleBox = createRow("Vehicle/Tank Speed", "2", false, function(state) vehicleEnabled = state end)
hitboxBox = createRow("Hitbox Size", "2", false, function(state)
	hitboxEnabled = state
	if not hitboxEnabled then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local hrp = player.Character:FindFirstChild("HumanoidRootPart")
				if hrp and originalSizes[player] then
					hrp.Size = originalSizes[player].Size
					hrp.Transparency = originalSizes[player].Transparency
					hrp.CanCollide = originalSizes[player].CanCollide
					hrp.Color = originalSizes[player].Color
					hrp.Material = originalSizes[player].Material
				end
			end
		end
		originalSizes = {}
	end
end)

createRow("Player ESP", "OFF", true, function(state)
	espEnabled = state
	if not espEnabled then
		for _, hl in pairs(highlights) do
			if hl then hl:Destroy() end
		end
		highlights = {}
		for _, conn in pairs(espConnections) do
			if conn then conn:Disconnect() end
		end
		espConnections = {}
	end
end)

