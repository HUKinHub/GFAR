local function createRow(labelText, defaultVal, yPos, callback, isToggleOnly)
	local rowFrame = Instance.new("Frame")
	rowFrame.Size = UDim2.new(1, -10, 0, 38)
	rowFrame.Position = UDim2.new(0, 0, 0, yPos)
	rowFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	rowFrame.BackgroundTransparency = 0.4
	rowFrame.BorderSizePixel = 0
	rowFrame.Parent = ScrollingFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = rowFrame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 220, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(220, 220, 220)
	label.TextSize = 13
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = rowFrame

	if isToggleOnly then
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 90, 0, 26)
		btn.Position = UDim2.new(1, -98, 0.5, -13)
		btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Text = "OFF"
		btn.TextSize = 12
		btn.Font = Enum.Font.GothamBold
		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 4)
		btnCorner.Parent = btn
		btn.Parent = rowFrame

		local state = false
		btn.MouseButton1Click:Connect(function()
			state = not state
			btn.Text = state and "ON" or "OFF"
			btn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(60, 60, 80)
			callback(state, nil)
		end)
	else
		local box = Instance.new("TextBox")
		box.Size = UDim2.new(0, 70, 0, 26)
		box.Position = UDim2.new(1, -178, 0.5, -13)
		box.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
		box.TextColor3 = Color3.fromRGB(255, 255, 255)
		box.Text = tostring(defaultVal)
		box.TextSize = 12
		box.Font = Enum.Font.GothamMedium
		box.ClearTextOnFocus = false
		local boxCorner = Instance.new("UICorner")
		boxCorner.CornerRadius = UDim.new(0, 4)
		boxCorner.Parent = box
		box.Parent = rowFrame

		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 80, 0, 26)
		btn.Position = UDim2.new(1, -98, 0.5, -13)
		btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Text = "OFF"
		btn.TextSize = 12
		btn.Font = Enum.Font.GothamBold
		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 4)
		btnCorner.Parent = btn
		btn.Parent = rowFrame

		local state = false
		btn.MouseButton1Click:Connect(function()
			state = not state
			btn.Text = state and "ON" or "OFF"
			btn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(60, 60, 80)
			callback(state, box)
		end)
	end
end

