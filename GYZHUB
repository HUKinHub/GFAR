-- 5. Helper Functions (Equip Weapon, Target Finder, Fast Attack)
local function EquipWeapon(weaponType)
    local Character = LocalPlayer.Character
    if not Character then return end
    local Backpack = LocalPlayer.Backpack

    for _, tool in ipairs(Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local isMatch = false
            if weaponType == "Melee" and tool.ToolTip == "Melee" then isMatch = true
            elseif weaponType == "Sword" and tool.ToolTip == "Sword" then isMatch = true
            elseif weaponType == "Blox Fruit" and (tool.ToolTip == "Blox Fruit" or tool.ToolTip == "Devil Fruit") then isMatch = true
            elseif weaponType == "Gun" and tool.ToolTip == "Gun" then isMatch = true
            end

            if isMatch then
                Character.Humanoid:EquipTool(tool)
                break
            end
        end
    end
end

