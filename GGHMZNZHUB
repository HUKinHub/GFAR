local function addToggle(page, title, desc, callback)
    local f = Instance.new("Frame")
    f.Parent = page
    f.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    f.BorderSizePixel = 0
    f.Size = UDim2.new(1, -10, 0, 48)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = f

    local lblTitle = Instance.new("TextLabel")
    lblTitle.Parent = f
    lblTitle.BackgroundTransparency = 1
    lblTitle.Position = UDim2.new(0, 12, 0, 6)
    lblTitle.Size = UDim2.new(0, 300, 0, 18)
    lblTitle.Font = Enum.Font.GothamBold
    lblTitle.Text = title
    lblTitle.TextColor3 = Color3.fromRGB(230, 230, 235)
    lblTitle.TextSize = 13
    lblTitle.TextXAlignment = Enum.TextXAlignment.Left

    local lblDesc = Instance.new("TextLabel")
    lblDesc.Parent = f
    lblDesc.BackgroundTransparency = 1
    lblDesc.Position = UDim2.new(0, 12, 0, 24)
    lblDesc.Size = UDim2.new(0, 350, 0, 16)
    lblDesc.Font = Enum.Font.Gotham
    lblDesc.Text = desc
    lblDesc.TextColor3 = Color3.fromRGB(140, 140, 150)
    lblDesc.TextSize = 11
    lblDesc.TextXAlignment = Enum.TextXAlignment.Left

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = f
    toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    toggleBtn.Position = UDim2.new(1, -55, 0.5, -12)
    toggleBtn.Size = UDim2.new(0, 45, 0, 24)
    toggleBtn.Text = ""
    toggleBtn.AutoButtonColor = false

    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(1, 0)
    tCorner.Parent = toggleBtn

    local circle = Instance.new("Frame")
    circle.Parent = toggleBtn
    circle.BackgroundColor3 = Color3.fromRGB(180, 180, 190)
    circle.Position = UDim2.new(0, 2, 0.5, -10)
    circle.Size = UDim2.new(0, 20, 0, 20)

    local cCorner = Instance.new("UICorner")
    cCorner.CornerRadius = UDim.new(1, 0)
    cCorner.Parent = circle

    local active = false
    toggleBtn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            circle:TweenPosition(UDim2.new(1, -22, 0.5, -10), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
            circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        else
            circle:TweenPosition(UDim2.new(0, 2, 0.5, -10), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            circle.BackgroundColor3 = Color3.fromRGB(180, 180, 190)
        end
        callback(active)
    end)
end

