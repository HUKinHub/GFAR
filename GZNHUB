local function createWeaponButton(weaponName, yPos)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 180, 0, 25)
    label.Position = UDim2.new(0, 5, 0, yPos)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextSize = 12
    label.Font = Enum.Font.SourceSans
    label.Text = " Teleport " .. weaponName
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = scrollingFrame

    local tpBtn = Instance.new("TextButton")
    tpBtn.Size = UDim2.new(0, 100, 0, 22)
    tpBtn.Position = UDim2.new(0, 195, 0, yPos)
    tpBtn.BackgroundColor3 = Color3.fromRGB(30, 120, 200)
    tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tpBtn.TextSize = 11
    tpBtn.Font = Enum.Font.SourceSansBold
    tpBtn.Text = "TELEPORT"
    tpBtn.Parent = scrollingFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = tpBtn

    tpBtn.MouseButton1Click:Connect(function()
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local hrp = character.HumanoidRootPart

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and string.find(string.lower(obj.Name), string.lower(weaponName)) and obj:FindFirstChild("Handle") then
                obj.Handle.CFrame = hrp.CFrame + Vector3.new(0, 2, 0)
            end
        end
    end)
end

