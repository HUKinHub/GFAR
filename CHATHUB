local function teleportWeapon(keyword)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local found = false

    for _, obj in ipairs(workspace:GetDescendants()) do
        if string.find(string.lower(obj.Name), string.lower(keyword)) then
            if obj:IsA("Tool") then
                obj.Parent = player.Backpack
                found = true
            elseif obj:IsA("Model") or obj:IsA("Part") then
                local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")) or obj
                if targetPart then
                    targetPart.CFrame = hrp.CFrame + Vector3.new(0, 2, 0)
                    found = true
                end
                local cd = obj:FindFirstChildWhichIsA("ClickDetector", true)
                if cd then
                    pcall(function() fireclickdetector(cd) end)
                    found = true
                end
                local pp = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                if pp then
                    pcall(function() fireproximityprompt(pp) end)
                    found = true
                end
            end
        end
    end

    if not found then
        local rs = game:GetService("ReplicatedStorage")
        for _, obj in ipairs(rs:GetDescendants()) do
            if obj:IsA("Tool") and string.find(string.lower(obj.Name), string.lower(keyword)) then
                local clone = obj:Clone()
                clone.Parent = player.Backpack
                found = true
                break
            end
        end
    end
end

