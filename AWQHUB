local function addSlider(page, title, desc, min, max, default, callback)
    local f = Instance.new("Frame", page)
    f.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    f.BorderSizePixel = 0
    f.Size = UDim2.new(1, -10, 0, 48)
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)

    local lblTitle = Instance.new("TextLabel", f)
    lblTitle.BackgroundTransparency = 1
    lblTitle.Position = UDim2.new(0, 12, 0, 6)
    lblTitle.Size = UDim2.new(0, 300, 0, 18)
    lblTitle.Font = Enum.Font.GothamBold
    lblTitle.Text = title
    lblTitle.TextColor3 = Color3.fromRGB(230, 230, 235)
    lblTitle.TextSize = 13
    lblTitle.TextXAlignment = Enum.TextXAlignment.Left

    local lblDesc = Instance.new("TextLabel", f)
    lblDesc.BackgroundTransparency = 1
    lblDesc.Position = UDim2.new(0, 12, 0, 24)
    lblDesc.Size = UDim2.new(0, 250, 0, 16)
    lblDesc.Font = Enum.Font.Gotham
    lblDesc.Text = desc
    lblDesc.TextColor3 = Color3.fromRGB(140, 140, 150)
    lblDesc.TextSize = 11
    lblDesc.TextXAlignment = Enum.TextXAlignment.Left

    local valLabel = Instance.new("TextLabel", f)
    valLabel.BackgroundTransparency = 1
    valLabel.Position = UDim2.new(1, -65, 0, 6)
    valLabel.Size = UDim2.new(0, 50, 0, 18)
    valLabel.Font = Enum.Font.GothamBold
    valLabel.Text = tostring(default)
    valLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    valLabel.TextSize = 13
    valLabel.TextXAlignment = Enum.TextXAlignment.Right

    local sliderBar = Instance.new("Frame", f)
    sliderBar.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    sliderBar.Position = UDim2.new(1, -165, 0.5, 6)
    sliderBar.Size = UDim2.new(0, 150, 0, 6)
    Instance.new("UICorner", sliderBar).CornerRadius = UDim.new(1, 0)

    local sliderFill = Instance.new("Frame", sliderBar)
    sliderFill.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
    sliderFill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
    Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

    local draggingSlider = false
    sliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
            sliderFill.Size = UDim2.new(pos, 0, 1, 0)
            local val = math.floor(min + (max - min) * pos)
            valLabel.Text = tostring(val)
            callback(val)
        end
    end)
end

