local function createToggleFeature(name, yPos, onToggled)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 160, 0, 30)
    label.Position = UDim2.new(0, 15, 0, yPos)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextSize = 13
    label.Font = Enum.Font.SourceSans
    label.Text = name
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = mainFrame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 95, 0, 26)
    toggleBtn.Position = UDim2.new(0, 185, 0, yPos + 2)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.TextSize = 11
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.Text = "OFF"
    toggleBtn.Parent = mainFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = toggleBtn

    local active = false
    toggleBtn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            toggleBtn.Text = "ON"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 100)
        else
            toggleBtn.Text = "OFF"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        end
        onToggled(active)
    end)
end

createToggleFeature("Auto Shake", 45, function(active)
    task.spawn(function()
        while active and task.wait(0.05) do
            pcall(function()
                for _, gui in ipairs(playerGui:GetDescendants()) do
                    if gui:IsA("TextButton") and (string.lower(gui.Text) == "shake" or string.lower(gui.Name) == "shake") then
                        gui.MouseButton1Click:Fire()
                    end
                end
            end)
        end
    end)
end)

local function createTeleportButton(name, targetCFrame, yPos)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 160, 0, 30)
    label.Position = UDim2.new(0, 15, 0, yPos)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextSize = 13
    label.Font = Enum.Font.SourceSans
    label.Text = name
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = mainFrame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 95, 0, 26)
    btn.Position = UDim2.new(0, 185, 0, yPos + 2)
    btn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 11
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = "TELEPORT"
    btn.Parent = mainFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = targetCFrame
        end
    end)
end

