local bg, bv
RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("Humanoid") then
		local humanoid = char.Humanoid
		if speedEnabled then
			local val = tonumber(speedBox.Text)
			if val and humanoid.WalkSpeed ~= val then
				humanoid.WalkSpeed = val
			end
		end
		if jumpEnabled then
			local val = tonumber(jumpBox.Text)
			if val then
				humanoid.UseJumpPower = true
				humanoid.JumpPower = math.clamp(val, 1, 50)
			end
		end
	end

	if flyEnabled and char and char:FindFirstChild("HumanoidRootPart") then
		local hrp = char.HumanoidRootPart
		local cam = workspace.CurrentCamera
		local speedVal = tonumber(flySpeedBox.Text) or 50
		local flySpeed = math.clamp(speedVal, 1, 300)

		if not bg or not bv or bg.Parent ~= hrp then
			if bg then bg:Destroy() end
			if bv then bv:Destroy() end
			bg = Instance.new("BodyGyro")
			bg.P = 9e4
			bg.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
			bg.CFrame = hrp.CFrame
			bg.Parent = hrp
			
			bv = Instance.new("BodyVelocity")
			bv.Velocity = Vector3.new(0, 0, 0)
			bv.MaxForce = Vector3.new(9e4, 9e4, 9e4)
			bv.Parent = hrp
		end

		bg.CFrame = cam.CFrame
		local moveDir = Vector3.new()
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
		bv.Velocity = moveDir * flySpeed
	else
		if bg then bg:Destroy() bg = nil end
		if bv then bv:Destroy() bv = nil end
	end
end)

RunService.Heartbeat:Connect(function()
	if vehicleEnabled then
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("Humanoid") then
			local humanoid = char.Humanoid
			if humanoid.SeatPart then
				local seat = humanoid.SeatPart
				local multiplier = tonumber(vehicleBox.Text) or 2
				if seat:IsA("VehicleSeat") and seat.Throttle ~= 0 then
					seat.AssemblyLinearVelocity = seat.AssemblyLinearVelocity * multiplier
				elseif seat.Parent and seat.Parent:IsA("Model") then
					for _, part in ipairs(seat.Parent:GetChildren()) do
						if part:IsA("BasePart") then
							part.AssemblyLinearVelocity = part.AssemblyLinearVelocity * (multiplier > 1 and 1.05 or 1)
						end
					end
				end
			end
		end
	end

	if hitboxEnabled then
		local sizeVal = tonumber(hitboxBox.Text) or 2
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local hrp = player.Character:FindFirstChild("HumanoidRootPart")
				local humanoid = player.Character:FindFirstChild("Humanoid")
				if hrp and humanoid then
					if not originalSizes[player] then
						originalSizes[player] = {
							Size = hrp.Size,
							Transparency = hrp.Transparency,
							CanCollide = hrp.CanCollide,
							Color = hrp.Color,
							Material = hrp.Material
						}
					end
					hrp.Size = Vector3.new(sizeVal * 2, sizeVal * 2, sizeVal * 2)
					hrp.Transparency = 0.85
					hrp.CanCollide = false
					hrp.Color = Color3.fromRGB(0, 100, 255)
					hrp.Material = Enum.Material.Neon
				end
			end
		end
	end

	if espEnabled then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					if not highlights[player] or highlights[player].Parent ~= player.Character then
						if highlights[player] then highlights[player]:Destroy() end
						local hl = Instance.new("Highlight")
						hl.Adornee = player.Character
						hl.FillColor = Color3.fromRGB(0, 150, 255)
						hl.OutlineColor = Color3.fromRGB(255, 255, 255)
						hl.FillTransparency = 0.5
						hl.Parent = player.Character
						highlights[player] = hl
					end
				else
					if highlights[player] then
						highlights[player]:Destroy()
						highlights[player] = nil
					end
				end
			end
		end
	end
end)
