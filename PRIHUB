local function createInputFeature(name, defaultVal, callback)
    order = order + 1
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -10, 0, 32)
    f.BackgroundTransparency = 1
    f.LayoutOrder = order
    f.Parent = scrollingFrame

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 110, 1, 0)
    lbl.Position = UDim2.new(0, 5, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(240, 220, 240)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.SourceSans
    lbl.Text = name
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 45, 0, 26)
    box.Position = UDim2.new(0, 115, 0, 3)
    box.BackgroundColor3 = Color3.fromRGB(50, 35, 60)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 12
    box.Font = Enum.Font.SourceSans
    box.Text = tostring(defaultVal)
    box.Parent = f

    local bc1 = Instance.new("UICorner")
    bc1.CornerRadius = UDim.new(0, 5)
    bc1.Parent = box

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 75, 0, 26)
    btn.Position = UDim2.new(1, -80, 0, 3)
    btn.BackgroundColor3 = Color3.fromRGB(180, 50, 70)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = "OFF"
    btn.Parent = f

    local bc2 = Instance.new("UICorner")
    bc2.CornerRadius = UDim.new(0, 5)
    bc2.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.Text = active and "ON" or "OFF"
        btn.BackgroundColor3 = active and Color3.fromRGB(60, 160, 100) or Color3.fromRGB(180, 50, 70)
        local val = tonumber(box.Text) or defaultVal
        callback(active, val)
    end)
end

