local function createInputFeature(name, defaultVal, onValueChanged)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 36)
    container.BackgroundTransparency = 1
    container.Parent = scrollingFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 140, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(240, 220, 245)
    label.TextSize = 13
    label.Font = Enum.Font.SourceSansSemibold
    label.Text = name
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(0, 50, 0, 28)
    textBox.Position = UDim2.new(0, 150, 0, 4)
    textBox.BackgroundColor3 = Color3.fromRGB(50, 40, 60)
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.TextSize = 12
    textBox.Font = Enum.Font.SourceSans
    textBox.Text = tostring(defaultVal)
    textBox.Parent = container

    local tbCorner = Instance.new("UICorner")
    tbCorner.CornerRadius = UDim.new(0, 6)
    tbCorner.Parent = textBox

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 85, 0, 28)
    toggleBtn.Position = UDim2.new(0, 210, 0, 4)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 80)
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.TextSize = 12
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.Text = "OFF"
    toggleBtn.Parent = container

    local tBtnCorner = Instance.new("UICorner")
    tBtnCorner.CornerRadius = UDim.new(0, 6)
    tBtnCorner.Parent = toggleBtn

    local active = false
    toggleBtn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            toggleBtn.Text = "ON"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 120)
        else
            toggleBtn.Text = "OFF"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 80)
        end
        onValueChanged(active, tonumber(textBox.Text) or defaultVal)
    end)
end

