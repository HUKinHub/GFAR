-- [แถวล่าง - ซ้าย] ช่องสีแดงสำหรับพิมพ์ความเร็ว (1-1000)
local SpeedBox = Instance.new("TextBox")
SpeedBox.Size = UDim2.new(0, 60, 0, 35)
SpeedBox.Position = UDim2.new(0, 5, 0, 42)
SpeedBox.BackgroundColor3 = Color3.fromRGB(230, 60, 20) -- สีแดงส้ม
SpeedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBox.TextSize = 14
SpeedBox.Font = Enum.Font.GothamBold
