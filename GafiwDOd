CreditLabel.Position = UDim2.new(0, 135, 0, 5)
CreditLabel.BackgroundColor3 = Color3.fromRGB(200, 50, 220) -- สีม่วง
CreditLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
CreditLabel.TextSize = 11
