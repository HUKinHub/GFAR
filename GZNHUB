local function createRow(name, defaultValue, yPos)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 180, 0, 25)
    label.Position = UDim2.new(0, 5, 0, yPos)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextSize = 12
    label.Font = Enum.Font.SourceSans
    label.Text = " " .. name
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = scrollingFrame

    local valBox = Instance.new("TextBox")
    valBox.Size = UDim2.new(0, 45, 0, 22)
    valBox.Position = UDim2.new(0, 195, 0, yPos)
    valBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    valBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    valBox.TextSize = 12
    valBox.Font = Enum.Font.SourceSans
    valBox.Text = tostring(defaultValue)
    valBox.Parent = scrollingFrame

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 4)
    boxCorner.Parent = valBox

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 50, 0, 22)
    toggleBtn.Position = UDim2.new(0, 245, 0, yPos)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 110)
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.TextSize = 11
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.Text = "On"
    toggleBtn.Parent = scrollingFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = toggleBtn

    toggleBtn.MouseButton1Click:Connect(function()
        if toggleBtn.Text == "On" then
            toggleBtn.Text = "Off"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        else
            toggleBtn.Text = "On"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 110)
        end
    end)
end

