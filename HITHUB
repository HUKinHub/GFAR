-- ESP Engine
local function CreateESP(player)
    if player == LocalPlayer then return end

    local function applyHighlight(char)
        if not char:FindFirstChild("GZ_ESP_Highlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "GZ_ESP_Highlight"
            highlight.FillColor = Color3.fromRGB(0, 200, 255)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = char
        end

        local head = char:FindFirstChild("Head")
        if head and not head:FindFirstChild("GZ_ESP_Tag") then
            local bb = Instance.new("BillboardGui")
            bb.Name = "GZ_ESP_Tag"
            bb.Size = UDim2.new(0, 100, 0, 30)
            bb.StudsOffset = Vector3.new(0, 2, 0)
            bb.AlwaysOnTop = true
            bb.Parent = head

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.Text = player.Name
            txt.TextColor3 = Color3.fromRGB(255, 255, 255)
            txt.Font = Enum.Font.FredokaOne
            txt.TextSize = 14
            txt.TextStrokeTransparency = 0
            txt.Parent = bb
        end
    end

    if player.Character then applyHighlight(player.Character) end
    player.CharacterAdded:Connect(applyHighlight)
end

