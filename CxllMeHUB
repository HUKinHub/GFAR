local invisState = false
createRow("Invisibility", "OFF", 220, function(state, box)
	invisState = state
	local char = LocalPlayer.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				part.Transparency = invisState and 1 or 0
			elseif part:IsA("Decal") then
				part.Transparency = invisState and 1 or 0
			end
		end
	end
end, true)

local antiKickState = false
createRow("Anti-Kick", "OFF", 264, function(state, box)
	antiKickState = state
	if antiKickState then
		pcall(function()
			local mt = getrawmetatable(game)
			setreadonly(mt, false)
			local old = mt.__namecall
			mt.__namecall = newcclosure(function(self, ...)
				local method = getnamecallmethod()
				if method == "Kick" and self == LocalPlayer then
					return
				end
				return old(self, ...)
			end)
			setreadonly(mt, true)
		end)
	end
end, true)

