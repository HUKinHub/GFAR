-- Auto Farm Level Logic
local function GetTargetMob()
    local Nearest = nil
    local Dist = math.huge
    local Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return nil end

    local Enemies = Workspace:FindFirstChild("Enemies")
    local TargetFolder = Enemies or Workspace

    for _, mob in ipairs(TargetFolder:GetChildren()) do
        if mob:IsA("Model") and mob ~= Character and mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart") then
            if mob.Humanoid.Health > 0 then
                local d = (mob.HumanoidRootPart.Position - Character.HumanoidRootPart.Position).Magnitude
                if d < Dist then
                    Dist = d
                    Nearest = mob
                end
            end
        end
    end
    return Nearest
end

task.spawn(function()
    while task.wait(0.1) do
        if getgenv().GZHUB.AutoFarm.Level then
            pcall(function()
                local Target = GetTargetMob()
                local Character = LocalPlayer.Character
                if Target and Character and Character:FindFirstChild("HumanoidRootPart") then
                    if getgenv().GZHUB.AutoFarm.AutoEquip then
                        EquipWeapon(getgenv().GZHUB.AutoFarm.SelectedWeapon)
                    end

                    -- Fast positioning above mob
                    Character.HumanoidRootPart.CFrame = Target.HumanoidRootPart.CFrame * CFrame.new(0, getgenv().GZHUB.AutoFarm.Distance, 0) * CFrame.Angles(math.rad(-90), 0, 0)

                    if getgenv().GZHUB.AutoFarm.FastAttack then
                        Attack()
                    end
                end
            end)
        end
    end
end)

