-- ระบบดึงปืนระบบใหม่: จำลองการหยิบปืนจากตู้/จุดแจกปืนของตำรวจในแมพ Prison Life (มีกระสุนและยิงได้จริง)
local function getRealGun(gunName)
    local foundGun = nil
    
    -- ค้นหาตัวต้นแบบปืนจากจุดแจกปืนหรือที่เก็บปืนใน Workspace ของแมพ
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Tool") or obj:IsA("Model")) and string.lower(obj.Name) == string.lower(gunName) then
            if obj:IsA("Tool") then
                foundGun = obj
                break
            else
                -- ถ้าเจอเป็น Model ปืน ให้แปลงหรือหา Tool ข้างใน
                local toolInside = obj:FindFirstChildWhichIsA("Tool")
                if toolInside then
                    foundGun = toolInside
                    break
                end
            end
        end
    end
    
    -- ถ้าหาใน Workspace ไม่เจอ ให้ค้นหาใน ReplicatedStorage
    if not foundGun then
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("Tool") and string.lower(obj.Name) == string.lower(gunName) then
                foundGun = obj
                break
            end
        end
    end
    
    -- ทำการโคลนปืนแท้พร้อมระบบสคริปต์ยิงใส่ Backpack ของผู้เล่น
    if foundGun then
        local clone = foundGun:Clone()
        clone.Parent = player.Backpack
        
        -- เชื่อมต่อระบบยิงและรีโหลดของปืน (GunScripts) หากมีอยู่ใน ReplicatedStorage
        local toolScripts = ReplicatedStorage:FindFirstChild("ToolScripts") or ReplicatedStorage:FindFirstChild("Scripts")
        if toolScripts then
            local gunController = toolScripts:FindFirstChild("GunController")
            if gunController and not clone:FindFirstChild("GunController") then
                gunController:Clone().Parent = clone
            end
        end
    end
end

