local function createLabel(text, yPos)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 280, 0, 18)
	label.Position = UDim2.new(0, 20, 0, yPos)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(200, 200, 200)
	label.TextSize, label.Font = 12, Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = MainFrame
	return label
end

local function createTextBox(defaultText, yPos)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0, 280, 0, 28)
	box.Position = UDim2.new(0, 20, 0, yPos)
	box.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
	box.TextColor3 = Color3.fromRGB(255, 255, 255)
	box.Text = defaultText
	box.TextSize, box.Font = 13, Enum.Font.GothamMedium
	box.ClearTextOnFocus = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = box
	box.Parent = MainFrame
	return box
end

local function createButton(text, yPos, color)
