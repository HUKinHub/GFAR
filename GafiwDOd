ScreenGui.Name = "BakuFlyGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

-- 2. สร้างกรอบเมนูหลัก (จัดเรียงแบบ Compact เล็กกะทัดรัด)
