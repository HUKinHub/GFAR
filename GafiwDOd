-- [แถวล่าง - กลาง] ปุ่มสีเหลือง `fly` (เปิด-ปิดบิน)
local FlyButton = Instance.new("TextButton")
FlyButton.Size = UDim2.new(0, 60, 0, 35)
FlyButton.Position = UDim2.new(0, 70, 0, 42)
FlyButton.BackgroundColor3 = Color3.fromRGB(255, 230, 50) -- สีเหลือง
FlyButton.TextColor3 = Color3.fromRGB(0, 0, 0)
FlyButton.TextSize = 13
FlyButton.Font = Enum.Font.GothamBold
FlyButton.Text = "fly"
