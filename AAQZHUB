local function addToggle(page, title, desc, callback)
    local f = Instance.new("Frame", page)
    f.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    f.BorderSizePixel = 0
    f.Size = UDim2.new(1, -10, 0, 45)
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)

    local tLbl = Instance.new("TextLabel", f)
    tLbl.BackgroundTransparency = 1
    tLbl.Position = UDim2.new(0, 10, 0, 5)
    tLbl.Size = UDim2.new(0, 250, 0, 18)
    tLbl.Font = Enum.Font.GothamBold
    tLbl.Text = title
    tLbl.TextColor3 = Color3.fromRGB(230, 230, 235)
    tLbl.TextSize = 13
    tLbl.TextXAlignment = Enum.TextXAlignment.Left

    local dLbl = Instance.new("TextLabel", f)
    dLbl.BackgroundTransparency = 1
    dLbl.Position = UDim2.new(0, 10, 0, 23)
    dLbl.Size = UDim2.new(0, 300, 0, 16)
    dLbl.Font = Enum.Font.Gotham
    dLbl.Text = desc
    dLbl.TextColor3 = Color3.fromRGB(140, 140, 150)
    dLbl.TextSize = 11
    dLbl.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton", f)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.Position = UDim2.new(1, -50, 0.5, -11)
    btn.Size = UDim2.new(0, 40, 0, 22)
    btn.Text = ""
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

    local circle = Instance.new("Frame", btn)
    circle.BackgroundColor3 = Color3.fromRGB(180, 180, 190)
    circle.Position = UDim2.new(0, 2, 0.5, -9)
    circle.Size = UDim2.new(0, 18, 0, 18)
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            circle:TweenPosition(UDim2.new(1, -20, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
            btn.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
            circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        else
            circle:TweenPosition(UDim2.new(0, 2, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            circle.BackgroundColor3 = Color3.fromRGB(180, 180, 190)
        end
        callback(active)
    end)
end

