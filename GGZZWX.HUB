CreateButton(p3, "👤 ซ่อนตัวละครให้ล่องหน (Client Invisible)", function()
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") or p:IsA("Decal") then
                    p.Transparency = 1
                end
            end
        end
    end)
end)

CreateButton(p3, "👤 คืนค่าความชัดตัวละคร (Make Visible)", function()
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.Transparency = 0
                elseif p:IsA("Decal") then
                    p.Transparency = 0
                end
            end
        end
    end)
end)

-- TAB 4: 📍 TELEPORT (วาร์ป)
