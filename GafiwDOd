DownButton.Position = UDim2.new(0, 70, 0, 5)
DownButton.BackgroundColor3 = Color3.fromRGB(220, 255, 100) -- สีเหลืองอ่อน
DownButton.TextColor3 = Color3.fromRGB(0, 0, 0)
DownButton.TextSize = 13
DownButton.Font = Enum.Font.GothamBold
DownButton.Text = "DOWN"
DownButton.Parent = MainFrame

-- [แถบบน - ขวา] เครดิต (สีม่วง) By บักคิว
local CreditLabel = Instance.new("TextLabel")
