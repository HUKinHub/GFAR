local vehicleSpeedEnabled = false
VehicleSpeedBtn.MouseButton1Click:Connect(function()
	vehicleSpeedEnabled = not vehicleSpeedEnabled
	VehicleSpeedBtn.Text = "Toggle Vehicle Speed: " .. (vehicleSpeedEnabled and "ON" or "OFF")
	VehicleSpeedBtn.BackgroundColor3 = vehicleSpeedEnabled and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(60, 60, 90)
end)

RunService.Heartbeat:Connect(function()
	if vehicleSpeedEnabled then
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("Humanoid") then
			local humanoid = char.Humanoid
			if humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
				local seat = humanoid.SeatPart
				local multiplier = tonumber(VehicleSpeedBox.Text) or 2
				if seat.Throttle ~= 0 then
					seat.AssemblyLinearVelocity = seat.AssemblyLinearVelocity * multiplier
				end
			end
		end
	end
end)

local hitboxEnabled = false
local originalSizes = {}

HitboxBtn.MouseButton1Click:Connect(function()
	hitboxEnabled = not hitboxEnabled
	HitboxBtn.Text = "Toggle Hitbox: " .. (hitboxEnabled and "ON" or "OFF")
	HitboxBtn.BackgroundColor3 = hitboxEnabled and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(60, 60, 90)
	
	if not hitboxEnabled then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local hrp = player.Character:FindFirstChild("HumanoidRootPart")
				if hrp and originalSizes[player] then
					hrp.Size = originalSizes[player].Size
					hrp.Transparency = originalSizes[player].Transparency
					hrp.CanCollide = originalSizes[player].CanCollide
					hrp.Color = originalSizes[player].Color
					hrp.Material = originalSizes[player].Material
				end
			end
		end
		originalSizes = {}
	end
end)

RunService.Heartbeat:Connect(function()
	if hitboxEnabled then
		local sizeVal = tonumber(HitboxBox.Text) or 2
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local hrp = player.Character:FindFirstChild("HumanoidRootPart")
				local humanoid = player.Character:FindFirstChild("Humanoid")
				if hrp and humanoid then
					if not originalSizes[player] then
						originalSizes[player] = {
							Size = hrp.Size,
							Transparency = hrp.Transparency,
							CanCollide = hrp.CanCollide,
							Color = hrp.Color,
							Material = hrp.Material
						}
					end
					
					-- คงสภาพ Hitbox ไว้แม้ตอนนั่งรถ (ไม่บัค ติดตามรถ/ตัวละครไปพร้อมกัน และปรับโปร่งใสสูง 0.9 เพื่อให้มองเห็นตัวคนและรถข้างในชัดเจน)
					hrp.Size = Vector3.new(sizeVal * 2, sizeVal * 2, sizeVal * 2)
					hrp.Transparency = 0.9
					hrp.CanCollide = false
					hrp.Color = Color3.fromRGB(0, 50, 200)
					hrp.Material = Enum.Material.Neon
				end
			end
		end
	end
end)

local invisEnabled = false
InvisBtn.MouseButton1Click:Connect(function()
	invisEnabled = not invisEnabled
	InvisBtn.Text = "Toggle Invisibility: " .. (invisEnabled and "ON" or "OFF")
	InvisBtn.BackgroundColor3 = invisEnabled and Color3.fromRGB(170, 0, 0) or Color3.fromRGB(90, 60, 60)
	
	local char = LocalPlayer.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				part.Transparency = invisEnabled and 1 or 0
			elseif part:IsA("Decal") then
				part.Transparency = invisEnabled and 1 or 0
			end
		end
		for _, acc in ipairs(char:GetChildren()) do
			if acc:IsA("Accessory") then
				local handle = acc:FindFirstChild("Handle")
				if handle then
					handle.Transparency = invisEnabled and 1 or 0
				end
			end
		end
	end
end)

local antiKickEnabled = false
AntiKickBtn.MouseButton1Click:Connect(function()
	antiKickEnabled = not antiKickEnabled
	AntiKickBtn.Text = "Toggle Anti-Kick: " .. (antiKickEnabled and "ON" or "OFF")
	AntiKickBtn.BackgroundColor3 = antiKickEnabled and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(60, 90, 60)
	
	if antiKickEnabled then
		pcall(function()
			local mt = getrawmetatable(game)
			setreadonly(mt, false)
			local old = mt.__namecall
			mt.__namecall = newcclosure(function(self, ...)
				local method = getnamecallmethod()
				if method == "Kick" and self == LocalPlayer then
					return
				end
				return old(self, ...)
			end)
			setreadonly(mt, true)
		end)
	end
end)
